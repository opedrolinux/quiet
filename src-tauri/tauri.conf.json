{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiet",
  "version": "2.0.0",
  "identifier": "com.quiet.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quiet",
        "width": 460,
        "height": 620,
        "x": 60,
        "y": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Quiet",
    "copyright": "Quiet",
    "shortDescription": "A notes app that gets out of the way.",
    "longDescription": "Quiet is a frameless, always-on-top note pad for studying. One keystroke in, one keystroke out, no toolbar, no tabs, no chrome.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
